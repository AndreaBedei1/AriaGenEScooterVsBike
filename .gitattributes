# Normalise text files to LF in the repository and in working trees, so the
# same checkout works on Windows and Linux (shell scripts must be LF).
* text=auto eol=lf

# Windows scripts keep CRLF in the working tree.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.npz binary
*.npy binary
*.pptx binary
*.docx binary
*.pdf binary
*.vrs binary
*.parquet binary
